# Agent Reach Configuration
# Copy to .env and fill in your values
# Or use: agent-reach configure

# Exa Search (free 1000/month) — https://exa.ai
# EXA_API_KEY=exa-your-key-here

# GitHub Token (optional, for higher rate limits) — https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your_token_here

# Reddit ISP Proxy (optional, for full Reddit access)
# REDDIT_PROXY=http://user:pass@ip:port

# Groq Whisper (optional, for video transcription) — https://console.groq.com
# GROQ_API_KEY=gsk_your_key_here

# OpenAI Whisper (optional fallback when Groq is rate-limited) — https://platform.openai.com
# OPENAI_API_KEY=sk-your_key_here

# ─── Media ladder (fork) ─────────────────────────────────────────────────
# docker-compose.yml reads this file. Values are never written to
# config.yaml — it holds only the variable name, via `api_key_env`.

# Vision endpoint, preferred. Free tier, low rate limit. Frames and clips
# leave this machine when a role points here.
# GEMINI_API_KEY_2=

# Same service, second key. Configured as the next endpoint in the list so a
# rate limit falls through to another quota before reaching the local model.
# GEMINI_API_KEY=

# Local llama-server behind a Bearer-checked reverse proxy. Nothing leaves the
# host. See docs/ENVIRONMENT.md.
# LLAMACPP_TOKEN=

# Bearer token for the ladder's own MCP endpoint, when it is published.
# Generated by deploy/apply.sh into deploy/.token (gitignored); set here only
# if you run the server without a proxy in front.
# REACH_MCP_TOKEN=
