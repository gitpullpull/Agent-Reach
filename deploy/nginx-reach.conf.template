# agent-reach media ladder over MCP, behind a Bearer check.
# apply.sh substitutes __TOKEN__ (from deploy/.token), __NGINX_PORT__ and
# __BACKEND__ before installing this to /etc/nginx/sites-available/reach.conf
server {
    listen 127.0.0.1:__NGINX_PORT__;

    set $expected_token "__TOKEN__";
    if ($http_authorization != "Bearer $expected_token") {
        return 401;
    }

    # MCP requests are small JSON; nothing is uploaded here. Frames and video
    # never leave the container -- only the extracted text comes back.
    client_max_body_size 8m;

    location / {
        proxy_pass         http://__BACKEND__;
        proxy_http_version 1.1;

        # Streamable HTTP is server-sent events. Buffering would hold the
        # whole response until the tool finished, which for a tier-2 call is
        # minutes -- long enough for the edge to give up first.
        proxy_buffering         off;
        proxy_request_buffering off;

        # A tier-2 call downloads a slice of video and describes every frame.
        # Minutes is normal; do not shorten these to "fail fast".
        proxy_connect_timeout 60s;
        proxy_send_timeout    1800s;
        proxy_read_timeout    1800s;

        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }
}
